@page "/Import"
@model Boh.Web.Pages.Import.IndexModel
@{
    ViewData["Title"] = "Import";
}

<h1>Import</h1>

<section>
    <h2>Upload a file</h2>

    <p>
        <small class="muted">
            Images and video up to @Model.MaxUploadMb MB. The file type is detected from content, not the filename.
        </small>
    </p>

    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="import-form">
        <input type="file" name="UploadedFile" required accept="image/*,video/*" aria-label="File to upload" />
        <button type="submit">Upload</button>
    </form>

    @if (Model.UploadError is not null)
    {
        <div class="notice notice-error" role="alert">@Model.UploadError</div>
    }

    @if (Model.DuplicateOfPostId is { } duplicateId)
    {
        <div class="notice" role="status">
            That file is already stored as
            <a href="/Posts/Detail/@duplicateId">post @duplicateId</a>.
        </div>
    }
</section>

<section id="imports">
    <h2>Import from a URL</h2>

    <p>
        <small class="muted">
            Fetches with <a href="https://github.com/mikf/gallery-dl" rel="noreferrer noopener">gallery-dl</a> and
            creates posts, mapping site metadata onto namespaced tags. Imports run in the background one at a
            time, so you can queue several and leave the page; they are listed here until the server restarts.
            At most @Model.MaxFiles file(s) per import, and a download is stopped after @Model.TimeoutSeconds seconds.
        </small>
    </p>

    <form method="post" asp-page-handler="Url" class="import-form">
        <input type="url" name="SourceUrl" value="@Model.SourceUrl" required
               placeholder="https://…" aria-label="URL to import" />
        <button type="submit">Import</button>
    </form>

    @if (Model.UrlError is not null)
    {
        <div class="notice notice-error" role="alert">@Model.UrlError</div>
    }

    @if (Model.Imports.Count > 0)
    {
        <h3>Recent imports</h3>

        @foreach (var job in Model.Imports)
        {
            <partial name="_ImportJob" model="job" />
        }
    }
</section>
