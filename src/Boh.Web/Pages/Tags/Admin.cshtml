@page "/Tags/Admin"
@model Boh.Web.Pages.Tags.AdminModel
@using Boh.Web.ViewModels
@{
    ViewData["Title"] = "Tag administration";
}

<header class="page-head">
    <h1>Tag administration</h1>
    <span class="head-actions">
        <a href="/Tags" role="button" class="secondary">All tags</a>
        <a href="/Maintenance" role="button" class="secondary">Maintenance</a>
    </span>
</header>

@if (Model.Message is not null)
{
    <div class="notice" role="status">@Model.Message</div>
}
@if (Model.Error is not null)
{
    <div class="notice notice-error" role="alert">@Model.Error</div>
}

<section>
    <h2>Namespaces</h2>
    <p><small class="muted">Colours distinguish namespaces across the gallery, tag lists and autocomplete. Every namespace gets a stable colour automatically; set one here to override it.</small></p>

    <form method="post" asp-page-handler="SetNamespaceColor" class="pair-form">
        <input type="text" name="ns" placeholder="namespace" aria-label="Namespace" required />
        <input type="color" name="color" value="#a371f7" aria-label="Colour" class="color-input" />
        <button type="submit">Set colour</button>
    </form>

    @if (Model.Namespaces.Count == 0)
    {
        <p class="muted"><small>No namespaced tags yet. Tag something <code>artist:name</code> and it will appear here.</small></p>
    }
    else
    {
        <div class="scroll-x">
            <table>
                <thead>
                    <tr><th scope="col">Namespace</th><th scope="col">Tags</th><th scope="col">Colour</th><th scope="col"></th></tr>
                </thead>
                <tbody>
                    @foreach (var ns in Model.Namespaces)
                    {
                        <tr>
                            <td>
                                <span class="tag-link" style="--tag-color: @ns.Color">@ns.Name:</span>
                            </td>
                            <td>@ns.TagCount</td>
                            <td>
                                <span class="swatch" style="background: @ns.Color"></span>
                                <code>@ns.Color</code>
                                @if (ns.IsDefault)
                                {
                                    <small class="muted">default</small>
                                }
                            </td>
                            <td>
                                @if (!ns.IsDefault)
                                {
                                    <form method="post" asp-page-handler="ResetNamespaceColor">
                                        <input type="hidden" name="ns" value="@ns.Name" />
                                        <button type="submit" class="secondary outline">Reset</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section>
    <h2>Move or rename a tag</h2>
    <p><small class="muted">Also how a tag is put into a namespace — <code>foo</code> to <code>artist:foo</code>. If the destination already exists the two are merged, keeping every post, alias and implication. The old name stops existing, so anything that keeps using it — including an importer — wants an alias instead.</small></p>

    <form method="post" asp-page-handler="MoveTag" class="pair-form">
        <partial name="_TagSuggestField" model='new TagSuggestField("from", "existing tag", "Existing tag")' />
        <span class="pair-arrow">&rarr;</span>
        <partial name="_TagSuggestField" model='new TagSuggestField("to", "new name", "New name")' />
        <button type="submit">Move</button>
    </form>
</section>

<section>
    <h2>Aliases</h2>
    <p><small class="muted">An alias never reaches storage — tagging a post with it stores the canonical tag instead. Creating one migrates existing posts. Unlike a move, the old name keeps redirecting for good.</small></p>

    <form method="post" asp-page-handler="AddAlias" class="pair-form">
        <partial name="_TagSuggestField" model='new TagSuggestField("alias", "alias tag", "Alias tag")' />
        <span class="pair-arrow">&rarr;</span>
        <partial name="_TagSuggestField" model='new TagSuggestField("canonical", "canonical tag", "Canonical tag")' />
        <button type="submit">Add alias</button>
    </form>

    @if (Model.Aliases.Count == 0)
    {
        <p class="muted"><small>No aliases defined.</small></p>
    }
    else
    {
        <div class="table-tools">
            <input type="search" placeholder="filter aliases…" aria-label="Filter aliases"
                   autocomplete="off" spellcheck="false"
                   data-filter-table="#alias-table" data-filter-status="#alias-filter-status" />
            <small id="alias-filter-status" class="muted" role="status" aria-live="polite">
                @Model.Aliases.Count alias@(Model.Aliases.Count == 1 ? "" : "es")
            </small>
        </div>

        <div class="scroll-x scroll-y">
            <table id="alias-table">
                <thead>
                    <tr><th scope="col">Alias</th><th scope="col">Canonical</th><th scope="col"></th></tr>
                </thead>
                <tbody>
                    @foreach (var alias in Model.Aliases)
                    {
                        <tr>
                            <td>@alias.Alias</td>
                            <td><a href="/?q=@Uri.EscapeDataString(alias.Canonical)">@alias.Canonical</a></td>
                            <td class="row-actions">
                                <form method="post" asp-page-handler="RemoveAlias">
                                    <input type="hidden" name="aliasTagId" value="@alias.AliasTagId" />
                                    <button type="submit" class="secondary outline">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr class="filter-empty" hidden>
                        <td colspan="3"><small class="muted">No aliases match that filter.</small></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

<section>
    <h2>Implications</h2>
    <p><small class="muted">Tagging a post with the child also applies the parent, transitively. Implied tags are marked on the post and cannot be removed by hand.</small></p>

    <form method="post" asp-page-handler="AddImplication" class="pair-form">
        <partial name="_TagSuggestField" model='new TagSuggestField("child", "child tag", "Child tag")' />
        <span class="pair-arrow">implies</span>
        <partial name="_TagSuggestField" model='new TagSuggestField("parent", "parent tag", "Parent tag")' />
        <button type="submit">Add implication</button>
    </form>

    @if (Model.Implications.Count == 0)
    {
        <p class="muted"><small>No implications defined.</small></p>
    }
    else
    {
        <div class="table-tools">
            <input type="search" placeholder="filter implications…" aria-label="Filter implications"
                   autocomplete="off" spellcheck="false"
                   data-filter-table="#implication-table" data-filter-status="#implication-filter-status" />
            <small id="implication-filter-status" class="muted" role="status" aria-live="polite">
                @Model.Implications.Count implication@(Model.Implications.Count == 1 ? "" : "s")
            </small>
        </div>

        <div class="scroll-x scroll-y">
            <table id="implication-table">
                <thead>
                    <tr><th scope="col">Child</th><th scope="col">Implies</th><th scope="col"></th></tr>
                </thead>
                <tbody>
                    @foreach (var implication in Model.Implications)
                    {
                        <tr>
                            <td><a href="/?q=@Uri.EscapeDataString(implication.Child)">@implication.Child</a></td>
                            <td><a href="/?q=@Uri.EscapeDataString(implication.Parent)">@implication.Parent</a></td>
                            <td class="row-actions">
                                <form method="post" asp-page-handler="RemoveImplication">
                                    <input type="hidden" name="childTagId" value="@implication.ChildTagId" />
                                    <input type="hidden" name="parentTagId" value="@implication.ParentTagId" />
                                    <button type="submit" class="secondary outline">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr class="filter-empty" hidden>
                        <td colspan="3"><small class="muted">No implications match that filter.</small></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

<section>
    <h2>Maintenance</h2>
    <div class="maintenance-actions">
        <form method="post" asp-page-handler="Rebuild">
            <button type="submit" class="secondary">Rebuild implied tags</button>
        </form>
        <form method="post" asp-page-handler="Recount">
            <button type="submit" class="secondary">Recount tag totals</button>
        </form>
    </div>
    <p><small class="muted">Rebuild recomputes every post's implied tags. Recount repairs post totals if they drift.</small></p>
</section>
