@page "/Account"
@model Boh.Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Account";
}

<h1>Account</h1>

@if (Model.AuthDisabled)
{
    <div class="notice" role="status">
        This instance runs with <code>BOH_AUTH_MODE=none</code>, so there are no accounts.
    </div>
}
else
{
    <p>
        Signed in as <strong>@Model.Username</strong>
        <small class="muted">(@(Model.IsAdmin ? "administrator" : "user"))</small>
    </p>
}

@if (Model.Message is not null)
{
    <div class="notice" role="status">@Model.Message</div>
}
@if (Model.Error is not null)
{
    <div class="notice notice-error" role="alert">@Model.Error</div>
}

@if (!Model.AuthDisabled)
{
    <section>
        <h2>Change password</h2>

        <form method="post" class="login-panel">
            <label for="current">
                Current password
                <input type="password" id="current" name="currentPassword"
                       autocomplete="current-password" required />
            </label>

            <label for="new">
                New password
                <input type="password" id="new" name="newPassword"
                       autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
                <small>At least @Model.MinPasswordLength characters.</small>
            </label>

            <label for="confirm">
                Confirm new password
                <input type="password" id="confirm" name="confirmPassword"
                       autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
            </label>

            <button type="submit">Change password</button>
        </form>
    </section>
}

<section>
    <h2>Theme</h2>

    <p>
        The button in the header switches between light and dark, or follows your system.
        These choose which colour scheme each side uses.
    </p>

    @* Where the choice gets stored. With no account to store against, app.js intercepts the
       submit and writes to localStorage instead. Spelled out as a value rather than a bare
       marker attribute: Razor renders a null attribute value as data-theme-local="", which
       hasAttribute() reads as present, so the account case would have taken the wrong path. *@
    <form method="post" asp-page-handler="Theme" id="theme-form"
          data-theme-store="@(Model.AuthDisabled ? "local" : "account")">
        <div class="theme-fields">
            @foreach (var field in new[]
            {
                (Id: "light-theme", Name: "lightTheme", Legend: "Light",
                 Mode: Boh.Web.Themes.LightMode, Current: Model.LightTheme),
                (Id: "dark-theme", Name: "darkTheme", Legend: "Dark",
                 Mode: Boh.Web.Themes.DarkMode, Current: Model.DarkTheme),
            })
            {
                <label for="@field.Id">
                    @field.Legend
                    <select id="@field.Id" name="@field.Name" data-theme-mode="@field.Mode">
                        <option value="" selected="@(string.IsNullOrEmpty(field.Current))">Default</option>
                        @foreach (var theme in Boh.Web.Themes.For(field.Mode))
                        {
                            <option value="@theme.Id" selected="@(theme.Id == field.Current)">@theme.Label</option>
                        }
                    </select>
                </label>
            }
        </div>

        <button type="submit">Save theme</button>
    </form>
</section>
