@page "/Account/Login"
@model Boh.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="login-panel">
    <h1>Sign in</h1>

    @if (Model.Error is not null)
    {
        <div class="notice notice-error" role="alert">@Model.Error</div>
    }

    <form method="post">
        <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string)" />

        <label for="username">
            Username
            <input type="text" id="username" name="Username" value="@Model.Username"
                   autocomplete="username" autocapitalize="none" required autofocus />
        </label>

        <label for="password">
            Password
            <input type="password" id="password" name="Password"
                   autocomplete="current-password" required />
        </label>

        <button type="submit">Sign in</button>
    </form>

    @if (Model.PasskeysUsable)
    {
        @* Hidden until passkeys.js has established that this browser can do it, so a
           browser without WebAuthn is never offered a button that cannot work. The form
           carries no method or action: the script owns the submit. *@
        <form id="passkey-signin" class="passkey-signin"
              data-passkey-options="/Account/Login?handler=PasskeyOptions"
              data-passkey-assert="/Account/Login?handler=Passkey&amp;returnUrl=@Uri.EscapeDataString((ViewData["ReturnUrl"] as string) ?? "/")"
              hidden>
            <button type="submit" class="secondary">Sign in with a passkey</button>
        </form>

        <div class="notice notice-error" role="alert" id="passkey-error" hidden></div>
    }
</div>

@section Scripts {
    <script src="~/js/passkeys.js" asp-append-version="true" defer></script>
}
