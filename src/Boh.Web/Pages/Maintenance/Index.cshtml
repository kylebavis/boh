@page "/Maintenance"
@model Boh.Web.Pages.Maintenance.IndexModel
@using Boh.Web.Jobs
@{
    ViewData["Title"] = "Maintenance";
}

<h1>Maintenance</h1>

<p>
    <small class="muted">
        Each task runs in the background, one after another, so you can start one and leave this
        page. The latest result of each stays here until the server restarts.
    </small>
</p>

<section id="@MaintenanceTask.Thumbnails.Key">
    <h2>Thumbnails</h2>
    <p>
        <small class="muted">
            Rebuilds thumbnails for posts that have none — generation that failed at upload, or
            thumbnails lost when moving storage. Missing ones are rebuilt from the originals, so
            this can take a while on a large archive.
        </small>
    </p>

    <partial name="_JobStatus" model="Model.StatusOf(MaintenanceTask.Thumbnails)" />

    <form method="post" asp-page-handler="Start" asp-route-task="@MaintenanceTask.Thumbnails.Key" class="action-form">
        <button type="submit" class="secondary">@MaintenanceTask.Thumbnails.Title</button>
    </form>
</section>

<section id="@MaintenanceTask.Hashes.Key">
    <h2>Perceptual hashes</h2>
    <p>
        <small class="muted">
            Computes the visual fingerprint that lets a resized or re-encoded repost be recognized,
            for posts stored before hashing existed or whose hashing failed. Originals are re-read,
            so this is slow on a large archive. Video is not hashed. New uploads are hashed as they
            arrive, so this is a one-off after upgrading — or after restoring a database from
            before the feature existed.
        </small>
    </p>

    <partial name="_JobStatus" model="Model.StatusOf(MaintenanceTask.Hashes)" />

    <form method="post" asp-page-handler="Start" asp-route-task="@MaintenanceTask.Hashes.Key" class="action-form">
        <button type="submit" class="secondary">@MaintenanceTask.Hashes.Title</button>
    </form>
</section>

<section id="@MaintenanceTask.Duplicates.Key">
    <h2>Possible duplicates</h2>
    <p>
        <small class="muted">
            Groups posts whose perceptual hashes are within @Model.MaxDistance bits of one another —
            the same picture stored twice at different sizes or qualities. Nothing is deleted: which
            copy to keep is a judgement about crops, watermarks and resolution that only you can
            make. Every pair of posts is compared, so on a large archive this takes a while.
        </small>
    </p>

    <partial name="_JobStatus" model="Model.StatusOf(MaintenanceTask.Duplicates)" />

    <form method="post" asp-page-handler="Start" asp-route-task="@MaintenanceTask.Duplicates.Key" class="action-form">
        <button type="submit" class="secondary">@MaintenanceTask.Duplicates.Title</button>
    </form>
</section>

<section id="@MaintenanceTask.ImpliedTags.Key">
    <h2>Implied tags</h2>
    <p>
        <small class="muted">
            Recomputes every post's implied tags from the current implications. Editing an
            implication already updates the posts it affects, so this is a repair for drift; it
            recounts tag totals on the way.
        </small>
    </p>

    <partial name="_JobStatus" model="Model.StatusOf(MaintenanceTask.ImpliedTags)" />

    <form method="post" asp-page-handler="Start" asp-route-task="@MaintenanceTask.ImpliedTags.Key" class="action-form">
        <button type="submit" class="secondary">@MaintenanceTask.ImpliedTags.Title</button>
    </form>
</section>

<section id="@MaintenanceTask.TagCounts.Key">
    <h2>Tag totals</h2>
    <p>
        <small class="muted">
            Recounts how many posts carry each tag, for when the totals beside tags have drifted
            from what is actually tagged.
        </small>
    </p>

    <partial name="_JobStatus" model="Model.StatusOf(MaintenanceTask.TagCounts)" />

    <form method="post" asp-page-handler="Start" asp-route-task="@MaintenanceTask.TagCounts.Key" class="action-form">
        <button type="submit" class="secondary">@MaintenanceTask.TagCounts.Title</button>
    </form>
</section>

<section id="@MaintenanceTask.UnusedTags.Key">
    <h2>Unused tags</h2>
    <p>
        <small class="muted">
            Deletes tags that no post carries — usually left behind when posts are deleted or
            retagged. Tags used by an alias or an implication are kept even with nothing tagged,
            since removing them would silently discard those rules.
        </small>
    </p>

    <partial name="_JobStatus" model="Model.StatusOf(MaintenanceTask.UnusedTags)" />

    <form method="post" asp-page-handler="Start" asp-route-task="@MaintenanceTask.UnusedTags.Key" class="action-form"
          onsubmit="return confirm('Delete every tag that no post uses? Aliases and implications are kept.');">
        <button type="submit" class="danger">@MaintenanceTask.UnusedTags.Title</button>
    </form>
</section>
