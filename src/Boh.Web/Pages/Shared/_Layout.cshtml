@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Boh.Web.BohOptions BohOptions
@{
    var title = ViewData["Title"] as string;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var showAccountControls = !BohOptions.AuthDisabled;

    // With auth off there is no identity, so everyone gets the administrative links —
    // matching the IsAdmin policy, which also falls away in that mode.
    var isAdmin = BohOptions.AuthDisabled || Boh.Web.Security.UserPrincipal.IsAdmin(User);

    // HTMX posts carry no form fields, so the antiforgery token rides along as a header
    // on every hx-* request issued from this document.
    var hxHeaders = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["RequestVerificationToken"] = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? ""
    });
}
<!DOCTYPE html>
@* No data-theme: absence is "auto". The script below applies a stored choice before paint. *@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13171f" media="(prefers-color-scheme: dark)" />
    <title>@(title is null ? "boh" : $"{title} — boh")</title>

    @* Synchronous, before paint, so the theme doesn't flip. Owns theme resolution; app.js only
       wires events. The nonce is the only inline script the CSP allows. *@
    <script nonce="@Boh.Web.Security.SecurityHeaders.CspNonce(Context)">
        (function () {
            var MODE_KEY = '@Boh.Web.Themes.ModeStorageKey';
            var PALETTE_KEY = '@Boh.Web.Themes.PaletteStorageKey';

            @* Signed in: palettes from the auth ticket. Otherwise "{}" and localStorage is read below. *@
            var palettes = @Html.Raw(Boh.Web.Themes.PaletteMapJson(
                Boh.Web.Security.UserPrincipal.GetLightTheme(User),
                Boh.Web.Security.UserPrincipal.GetDarkTheme(User)));
            var fromServer = @(signedIn ? "true" : "false");

            var choice = '@Boh.Web.Themes.DefaultMode';
            try {
                if (!fromServer) palettes = JSON.parse(localStorage.getItem(PALETTE_KEY)) || {};

                var stored = localStorage.getItem(MODE_KEY);
                if (stored === 'light' || stored === 'dark' || stored === 'auto') choice = stored;
            } catch (e) { /* storage blocked or corrupt; the defaults are a fine fallback */ }

            var media = window.matchMedia('(prefers-color-scheme: dark)');

            function apply(next) {
                choice = next;

                // "auto" is resolved here rather than left to Pico's own media query so that
                // everything downstream has a definite mode to look up a palette with. The
                // listener in app.js keeps it honest when the OS flips.
                var mode = next === 'auto' ? (media.matches ? 'dark' : 'light') : next;
                var root = document.documentElement;

                root.dataset.themeChoice = next;
                root.dataset.theme = mode;

                var name = palettes[mode];
                if (name) root.dataset.themeName = name;
                else delete root.dataset.themeName;
            }

            window.bohTheme = {
                media: media,
                apply: apply,
                choice: function () { return choice; },

                // Lets the account page preview a pick without a round trip.
                palettes: function (next) { palettes = next; }
            };

            apply(choice);
        })();
    </script>

    <link rel="stylesheet" href="~/css/pico.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
    <script src="~/js/htmx.min.js" asp-append-version="true" defer></script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
</head>
<body hx-headers='@hxHeaders'>
    <header class="container">
        <nav>
            <ul>
                <li><a href="/" class="brand"><strong>boh</strong></a></li>
            </ul>
            <ul class="nav-search">
                <li>
                    @* A sibling, not a child: Pico rounds only a [role=search] group's first and last children. *@
                    <form action="/" method="get" role="search" autocomplete="off">
                        <input type="search" name="q" value="@(ViewData["Query"] as string)"
                               placeholder="tag search…" aria-label="Search posts by tag"
                               role="combobox" aria-expanded="false" aria-autocomplete="list"
                               aria-controls="search-suggestions"
                               data-suggest-for="#search-suggestions"
                               hx-get="/Tags/Autocomplete"
                               hx-trigger="keyup changed delay:200ms"
                               hx-sync="this:replace"
                               hx-target="#search-suggestions"
                               hx-swap="innerHTML" />
                    </form>
                    <div id="search-suggestions" class="suggestions"></div>
                </li>
            </ul>
            <ul>
                <li>
                    <a href="/Posts/Random@(string.IsNullOrWhiteSpace(ViewData["Query"] as string)
                        ? "" : $"?q={Uri.EscapeDataString((string)ViewData["Query"]!)}")"
                       title="Jump to a random post">Random</a>
                </li>
                <li><a href="/Tags">Tags</a></li>
                @if (!showAccountControls || signedIn)
                {
                    <li><a href="/Import">Import</a></li>
                }
                @if (isAdmin)
                {
                    <li><a href="/Users">Users</a></li>
                    <li><a href="/Maintenance">Maintenance</a></li>
                }
                @if (showAccountControls)
                {
                    @if (signedIn)
                    {
                        <li><a href="/Account" class="nav-user" title="Signed in as @User.Identity!.Name">@User.Identity!.Name</a></li>
                        <li>
                            <form method="post" action="/Account/Logout" class="inline-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="link-button">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li><a href="/Account/Login">Sign in</a></li>
                    }
                }
                <li>
                    @* Cycles auto -> light -> dark; palettes are an account setting. *@
                    <button type="button" id="theme-toggle" class="secondary outline"
                            aria-label="Theme: follow system" title="Theme: follow system">
                        <svg class="icon icon-auto" viewBox="0 0 24 24" aria-hidden="true"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" />
                        </svg>
                        <svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                        </svg>
                        <svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                        </svg>
                    </button>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="container">
        <small>boh — self-hosted imageboard</small>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
