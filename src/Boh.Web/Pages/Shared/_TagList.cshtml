@model Boh.Web.ViewModels.PostTagView
@functions {
    // The namespace is not printed on the chip — colour carries it. It stays in the tooltip
    // so the full tag is recoverable, and in the href and remove handler so both act on the
    // real tag rather than the shortened label.
    static string Tooltip(Boh.Web.ViewModels.PostTagEntry tag) =>
        (tag.Namespace.Length > 0 ? $"{tag.Display} — " : "")
        + (tag.Implied ? "implied by another tag" : $"{tag.PostCount} post(s)");
}

<div id="tag-list">
    @if (Model.Error is not null)
    {
        <p class="tag-error" role="alert"><small>@Model.Error</small></p>
    }

    @if (Model.Tags.Count == 0)
    {
        <p><small class="muted">No tags yet.</small></p>
    }
    else
    {
        <ul class="tag-chips">
            @foreach (var tag in Model.Tags)
            {
                <li class="tag-chip @(tag.Implied ? "tag-implied" : "")"
                    style="@(tag.Color is null ? null : $"--tag-color: {tag.Color}")"
                    title="@Tooltip(tag)">
                    <a href="/?q=@Uri.EscapeDataString(tag.Display)">@tag.Name</a>
                    <span class="tag-count">@tag.PostCount</span>
                    @if (Model.CanEdit && !tag.Implied)
                    {
                        <button type="button" class="tag-remove"
                                aria-label="Remove tag @tag.Display"
                                hx-post="/Posts/Detail/@Model.PostId?handler=RemoveTag&ns=@Uri.EscapeDataString(tag.Namespace)&name=@Uri.EscapeDataString(tag.Name)"
                                hx-target="#tag-list"
                                hx-swap="outerHTML">&times;</button>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.CanEdit)
    {
        @* The listener behind data-reset-on-success only fires when the form itself made the
           request, which is essential rather than defensive: htmx events bubble, and the
           input inside this form issues its own request on every keystroke for autocomplete.
           Without that check, each suggestion fetch completing would reset the form and wipe
           what the user was typing, leaving them unable to enter more than one character.
           It lives in app.js because htmx evaluates hx-on handlers with new Function, which
           the content security policy does not permit. *@
        <form class="tag-add"
              hx-post="/Posts/Detail/@Model.PostId?handler=AddTags"
              hx-target="#tag-list"
              hx-swap="outerHTML"
              data-reset-on-success
              autocomplete="off">
            <input type="text" name="tags" placeholder="add tags…"
                   aria-label="Add tags"
                   role="combobox" aria-expanded="false" aria-autocomplete="list"
                   aria-controls="tag-add-suggestions"
                   data-suggest-for="#tag-add-suggestions"
                   hx-get="/Tags/Autocomplete"
                   hx-trigger="keyup changed delay:200ms"
                   hx-target="#tag-add-suggestions"
                   hx-swap="innerHTML" />
            <button type="submit">Add</button>
        </form>
        <div id="tag-add-suggestions" class="suggestions"></div>
    }
</div>
