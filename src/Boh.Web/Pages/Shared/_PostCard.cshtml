@model Boh.Web.ViewModels.GalleryCard
@{
    var post = Model.Post;
}

<a class="gallery-item" href="@GalleryLinks.Detail(post.Id, Model.FromPage, Model.Query)"
   title="Post @post.Id">
    <img src="@PostUrls.Thumb(post)" alt="Post @post.Id" loading="lazy"
         width="@post.Width" height="@post.Height" />
    @if (post.IsVideo)
    {
        <span class="badge">video</span>
    }
</a>
