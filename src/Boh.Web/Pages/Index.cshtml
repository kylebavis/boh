@page
@model IndexModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? null : $"Search: {Model.Query}";
    var searching = !string.IsNullOrWhiteSpace(Model.Query);
}

@if (Model.TotalCount == 0)
{
    <div class="gallery-empty">
        @if (searching)
        {
            <p>No posts match <code>@Model.Query</code>.</p>
            <a href="/" role="button" class="secondary">Clear search</a>
        }
        else
        {
            <p>Nothing here yet.</p>
            @if (Model.CanUpload)
            {
                <a href="/Posts/Upload" role="button">Upload the first post</a>
            }
        }
    </div>
}
else
{
    <p>
        <small>
            @Model.TotalCount post@(Model.TotalCount == 1 ? "" : "s")
            @if (searching)
            {
                <text>matching <code>@Model.Query</code> — <a href="/">clear</a></text>
            }
        </small>
    </p>

    <div class="gallery">
        @foreach (var post in Model.Posts)
        {
            <partial name="_PostCard"
                     model="new Boh.Web.ViewModels.GalleryCard(post, Model.CurrentPage, Model.Query)" />
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination">
            <a href="@Model.PageUrl(Model.CurrentPage - 1)" role="button" class="secondary"
               aria-disabled="@(Model.CurrentPage <= 1 ? "true" : "false")">Previous</a>

            <span><small>Page @Model.CurrentPage of @Model.TotalPages</small></span>

            <a href="@Model.PageUrl(Model.CurrentPage + 1)" role="button" class="secondary"
               aria-disabled="@(Model.CurrentPage >= Model.TotalPages ? "true" : "false")">Next</a>
        </nav>
    }
}
