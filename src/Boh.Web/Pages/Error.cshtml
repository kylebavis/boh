@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1>Something went wrong</h1>
<p>The request could not be completed. The server log has the details.</p>

@if (Model.ShowRequestId)
{
    <p><small>Request ID: <code>@Model.RequestId</code></small></p>
}

<p><a href="/" role="button" class="secondary">Back to the gallery</a></p>
