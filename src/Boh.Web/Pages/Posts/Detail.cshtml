@page "{id:int}"
@model Boh.Web.Pages.Posts.DetailModel
@{
    var post = Model.Post;
    ViewData["Title"] = $"Post {post.Id}";
}

<div class="post-view">
    <div class="post-media">
        @if (post.IsVideo)
        {
            <video controls preload="metadata" src="@PostUrls.Original(post)"></video>
        }
        else
        {
            <a href="@PostUrls.Original(post)">
                <img src="@PostUrls.Original(post)" alt="Post @post.Id"
                     width="@post.Width" height="@post.Height" />
            </a>
        }
    </div>

    @* Everything sits below the media in one column. Tags are the variable-length part, so
       they lead; the fixed facts tile underneath. *@
    <section class="post-below">
        <div class="tag-section">
            <h2>Tags</h2>
            <partial name="_TagList" model="Model.TagView" />
        </div>

        @* Its own section rather than a row in the facts list below: sources are editable and
           there can be several, so they need the room a <dd> in a two-column grid does not have. *@
        <div class="source-section">
            <partial name="_SourceList" model="Model.SourceView" />
        </div>

        @* Only rendered when there is something to say, so an ordinary post is unaffected by
           the feature existing. Nothing here blocked the upload: a perceptual match is a
           suspicion, and the two posts are equally likely to be the one worth keeping. *@
        @if (Model.Similar.Count > 0)
        {
            <div class="similar-section">
                <h2>Possible duplicates</h2>
                <p>
                    <small class="muted">
                        The badge counts how many bits of the perceptual hash differ, so lower
                        is more alike.
                        <a href="@Model.SimilarSearchUrl">Browse them in the gallery</a>.
                    </small>
                </p>

                <div class="gallery">
                    @foreach (var card in Model.Similar)
                    {
                        <a class="gallery-item" href="/Posts/Detail/@card.Post.Id"
                           title="Post @card.Post.Id — @card.Distance bit@(card.Distance == 1 ? "" : "s") different">
                            <img src="@PostUrls.Thumb(card.Post)" alt="Post @card.Post.Id" loading="lazy"
                                 width="@card.Post.Width" height="@card.Post.Height" />
                            <span class="badge">@card.Distance</span>
                        </a>
                    }
                </div>
            </div>
        }

        <dl class="post-facts">
            <div>
                <dt>Dimensions</dt>
                <dd>@post.Width × @post.Height</dd>
            </div>
            <div>
                <dt>Size</dt>
                <dd>@PostUrls.HumanSize(post.FileSizeBytes)</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@post.MimeType</dd>
            </div>

            @if (post.DurationSec is { } duration)
            {
                <div>
                    <dt>Duration</dt>
                    <dd>@TimeSpan.FromSeconds(duration).ToString(@"m\:ss")</dd>
                </div>
            }

            <div>
                <dt>Uploaded</dt>
                <dd><time datetime="@post.UploadedAt.ToString("o")">@post.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC</time></dd>
            </div>

            <div class="fact-wide">
                <dt>SHA-256</dt>
                <dd><code>@post.Sha256</code></dd>
            </div>
        </dl>

        <div class="post-actions">
            <a href="@PostUrls.Original(post)" download role="button" class="secondary">Download original</a>

            @if (Model.CanEdit)
            {
                <form method="post" asp-page-handler="Delete"
                      onsubmit="return confirm('Delete post @post.Id? This cannot be undone.');">
                    @* Where to go afterwards: the listing this post was opened from. *@
                    <input type="hidden" name="q" value="@Model.Query" />
                    <input type="hidden" name="fromPage" value="@Model.FromPage" />
                    <button type="submit" class="danger">Delete post</button>
                </form>
            }
        </div>
    </section>
</div>
