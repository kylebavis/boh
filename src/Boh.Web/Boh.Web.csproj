<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Apache-2.0, no build-time license key. ImageSharp was the first choice but 4.0
      enforces a per-organization `sixlabors.lic` file for direct dependencies, which
      would stop any contributor or CI job from building without first obtaining a key.
      Q8 is the right quantum depth here: originals are stored byte-for-byte untouched
      and only thumbnails are re-encoded, so 8 bits per channel costs nothing visible
      while halving decode memory. AnyCPU bundles linux-x64 and linux-arm64 natives.
      Because these are C decoders handling untrusted uploads, ResourceLimits and a
      format allowlist are applied in MagickMediaProcessor.
    -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
  </ItemGroup>

</Project>
